<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pauseDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/zen_app_background"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/pauseDialogScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/pauseCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/zen_dialog_inset"
                android:layout_marginEnd="@dimen/zen_dialog_inset"
                android:background="@drawable/zen_dialog_surface"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/zen_dialog_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/zen_dialog_max_width">

        <ImageView
            android:id="@+id/pauseMenuImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/zen_icon_surface"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gameplay_pause"
            app:tint="@color/zen_primary" />

                <TextView
                    android:id="@+id/pauseDialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/pause_title"
                    android:textColor="@color/gameplay_ink"
                    android:textSize="@dimen/zen_dialog_title_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/ubuntu_regular"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/pause_message"
            android:textColor="@color/gameplay_ink_muted"
            android:textSize="@dimen/zen_body_size" />

                <Button
                    android:id="@+id/resume_bttn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/zen_button_primary"
                    android:fontFamily="@font/ubuntu_medium"
                    android:minHeight="@dimen/zen_dialog_button_height"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/pause_resume"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/options_bttn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/zen_button_secondary"
                    android:fontFamily="@font/ubuntu_medium"
                    android:minHeight="@dimen/zen_dialog_button_height"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/pause_options"
                    android:textAllCaps="false"
                    android:textColor="@color/gameplay_ink"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/exit_bttn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/zen_button_danger"
                    android:fontFamily="@font/ubuntu_medium"
                    android:minHeight="@dimen/zen_dialog_button_height"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/pause_exit"
                    android:textAllCaps="false"
                    android:textColor="@color/zen_danger"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
