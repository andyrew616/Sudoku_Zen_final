<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/menu_screen_inset"
        android:paddingTop="@dimen/menu_top_inset"
        android:paddingEnd="@dimen/menu_screen_inset"
        android:paddingBottom="@dimen/menu_bottom_inset">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_brand_height">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top|center_horizontal"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo_banner" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/menu_title_to_content_gap"
            android:text="@string/menu_play_heading"
            android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Section" />

        <GridLayout
            android:id="@+id/playModeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alignmentMode="alignMargins"
            android:columnCount="@integer/menu_grid_columns"
            android:orientation="horizontal"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/Start"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_play_tile_height"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_marginEnd="@dimen/menu_grid_half_gap"
                android:background="@drawable/menu_primary_tile_background"
                android:clickable="true"
                android:clipChildren="false"
                android:contentDescription="@string/start_Bttn"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/menu_min_touch_target"
                android:minHeight="@dimen/menu_min_touch_target"
                android:orientation="vertical"
                android:paddingStart="@dimen/menu_tile_padding"
                android:paddingTop="@dimen/menu_tile_top_padding"
                android:paddingEnd="@dimen/menu_tile_padding"
                android:paddingBottom="@dimen/menu_tile_padding">

                <ImageView
                    android:layout_width="@dimen/menu_play_icon_size"
                    android:layout_height="@dimen/menu_play_icon_size"
                    android:alpha="0.86"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/menu_icon_new_game" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_new_game"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_new_game_subtitle"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Resume"
                android:layout_width="0dp"
                android:layout_height="@dimen/menu_play_tile_height"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_marginStart="@dimen/menu_grid_half_gap"
                android:background="@drawable/menu_play_tile_background"
                android:clickable="true"
                android:clipChildren="false"
                android:contentDescription="@string/resume"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/menu_min_touch_target"
                android:minHeight="@dimen/menu_min_touch_target"
                android:orientation="vertical"
                android:paddingStart="@dimen/menu_tile_padding"
                android:paddingTop="@dimen/menu_tile_top_padding"
                android:paddingEnd="@dimen/menu_tile_padding"
                android:paddingBottom="@dimen/menu_tile_padding">

                <ImageView
                    android:layout_width="@dimen/menu_play_icon_size"
                    android:layout_height="@dimen/menu_play_icon_size"
                    android:alpha="0.76"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/menu_icon_resume" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resume_game"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/menu_resume_subtitle"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Subtitle" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/menu_utility_gap"
            android:text="@string/menu_utility_heading"
            android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Section" />

        <LinearLayout
            android:id="@+id/OptnBttn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_utility_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/menu_utility_background"
            android:clickable="true"
            android:contentDescription="@string/options_bttn"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/menu_min_touch_target"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="@dimen/menu_utility_icon_size"
                android:layout_height="@dimen/menu_utility_icon_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:alpha="0.68"
                android:scaleType="fitCenter"
                android:src="@drawable/menu_icon_options" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/options"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.UtilityTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/menu_options_subtitle"
                    android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Subtitle" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:text="@string/menu_disclosure"
                android:textColor="@color/gameplay_ink_muted"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
