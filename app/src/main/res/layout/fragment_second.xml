<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/menu_screen_inset"
        android:paddingTop="@dimen/menu_top_inset"
        android:paddingEnd="@dimen/menu_screen_inset"
        android:paddingBottom="@dimen/menu_bottom_inset">

        <ImageButton
            android:id="@+id/button_second"
            android:layout_width="@dimen/menu_min_touch_target"
            android:layout_height="@dimen/menu_min_touch_target"
            android:background="@drawable/menu_back_background"
            android:contentDescription="@string/menu_back"
            android:minWidth="@dimen/menu_min_touch_target"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/left_arrow"
            app:tint="@color/menu_back_icon" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/menu_choose_difficulty"
            android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/menu_difficulty_intro"
            android:textAppearance="@style/TextAppearance.ZenSudoku.Menu.Body" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/menu_difficulty_gap"
            android:alignmentMode="alignMargins"
            android:columnCount="@integer/menu_grid_columns"
            android:orientation="horizontal"
            android:rowOrderPreserved="true"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/Easy"
                style="@style/MenuDifficultyTile"
                android:layout_marginEnd="@dimen/menu_grid_half_gap"
                android:background="@drawable/menu_difficulty_easy_background"
                android:contentDescription="@string/easy_mode">

                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_easy" />

                <ImageView
                    android:layout_width="@dimen/menu_difficulty_emblem_size"
                    android:layout_height="@dimen/menu_difficulty_emblem_size"
                    android:layout_marginTop="@dimen/menu_difficulty_emblem_gap"
                    android:alpha="0.84"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/difficulty_easy_emblem" />

                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_easy_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Medium"
                style="@style/MenuDifficultyTile"
                android:layout_marginStart="@dimen/menu_grid_half_gap"
                android:layout_marginEnd="@dimen/menu_medium_tile_end_margin"
                android:background="@drawable/menu_difficulty_medium_background"
                android:contentDescription="@string/medium_difficulty">

                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_medium" />

                <ImageView
                    android:layout_width="@dimen/menu_difficulty_emblem_size"
                    android:layout_height="@dimen/menu_difficulty_emblem_size"
                    android:layout_marginTop="@dimen/menu_difficulty_emblem_gap"
                    android:alpha="0.76"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/difficulty_medium_emblem" />

                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_medium_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/HardBttn"
                style="@style/MenuDifficultyTile"
                android:layout_columnSpan="@integer/menu_difficulty_terminal_span"
                android:layout_marginStart="@dimen/menu_hard_tile_start_margin"
                android:layout_marginTop="@dimen/menu_hard_tile_top_margin"
                android:layout_marginEnd="@dimen/menu_hard_tile_end_margin"
                android:background="@drawable/menu_difficulty_hard_background"
                android:contentDescription="@string/hard_difficulty">

                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_hard" />

                <ImageView
                    android:layout_width="@dimen/menu_difficulty_emblem_size"
                    android:layout_height="@dimen/menu_difficulty_emblem_size"
                    android:layout_marginTop="@dimen/menu_difficulty_emblem_gap"
                    android:alpha="0.76"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/difficulty_hard_emblem" />

                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_hard_subtitle" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</ScrollView>
