<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/menu_screen_inset"
        android:paddingTop="@dimen/menu_top_inset"
        android:paddingEnd="@dimen/menu_screen_inset"
        android:paddingBottom="@dimen/menu_bottom_inset">

        <ImageButton
            android:id="@+id/button_second"
            android:layout_width="@dimen/menu_min_touch_target"
            android:layout_height="@dimen/menu_min_touch_target"
            android:background="@drawable/menu_back_background"
            android:contentDescription="@string/menu_back"
            android:minWidth="@dimen/menu_min_touch_target"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/left_arrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/menu_choose_difficulty"
            android:textColor="@color/gameplay_ink"
            android:textSize="@dimen/menu_screen_title_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/menu_difficulty_intro"
            android:textColor="@color/gameplay_ink_muted"
            android:textSize="@dimen/menu_body_size" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/menu_difficulty_gap"
            android:alignmentMode="alignMargins"
            android:columnCount="@integer/menu_grid_columns"
            android:orientation="horizontal"
            android:rowOrderPreserved="true"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/Easy"
                style="@style/MenuDifficultyTile"
                android:layout_marginEnd="@dimen/menu_grid_half_gap"
                android:contentDescription="@string/easy_mode">

                <TextView style="@style/MenuDifficultyNumber" android:text="01" />
                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_easy" />
                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_easy_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/Medium"
                style="@style/MenuDifficultyTile"
                android:layout_marginStart="@dimen/menu_grid_half_gap"
                android:contentDescription="@string/medium_difficulty">

                <TextView style="@style/MenuDifficultyNumber" android:text="02" />
                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_medium" />
                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_medium_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/HardBttn"
                style="@style/MenuDifficultyTile"
                android:layout_marginStart="@dimen/menu_hard_tile_start_margin"
                android:layout_marginTop="@dimen/menu_hard_tile_top_margin"
                android:layout_marginEnd="@dimen/menu_hard_tile_end_margin"
                android:contentDescription="@string/hard_difficulty">

                <TextView style="@style/MenuDifficultyNumber" android:text="03" />
                <TextView style="@style/MenuDifficultyTitle" android:text="@string/menu_hard" />
                <TextView style="@style/MenuDifficultySubtitle" android:text="@string/menu_hard_subtitle" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/menu_difficulty_hint"
            android:textColor="@color/gameplay_ink_muted"
            android:textSize="@dimen/menu_tile_subtitle_size" />
    </LinearLayout>
</ScrollView>
