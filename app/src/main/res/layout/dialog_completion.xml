<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/completionDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_dialog_scrim"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/completionDialogScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/completionCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/zen_dialog_inset"
                android:layout_marginEnd="@dimen/zen_dialog_inset"
                android:background="@drawable/zen_dialog_surface"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/zen_dialog_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/zen_dialog_max_width">

        <ImageView
            android:id="@+id/completionImageView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/zen_icon_surface"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_icon_circle" />

                <TextView
                    android:id="@+id/completionDialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/completion_title"
                    android:textColor="@color/gameplay_ink"
                    android:textSize="@dimen/zen_dialog_title_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/ubuntu_regular"
            android:gravity="center"
            android:text="@string/completion_message"
            android:textColor="@color/gameplay_ink_muted"
            android:textSize="@dimen/zen_body_size" />

        <TextView
            android:id="@+id/completionDifficultyTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/gameplay_mode_pill"
            android:fontFamily="@font/ubuntu_medium"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="@color/gameplay_mode_ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/zen_surface_card"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/totalTimeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_medium"
                android:gravity="center"
                android:textColor="@color/gameplay_ink"
                android:textSize="15sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/gameplay_divider"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hintsUsedTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ubuntu_medium"
                android:gravity="center"
                android:textColor="@color/gameplay_ink"
                android:textSize="15sp" />
        </LinearLayout>

                <Button
                    android:id="@+id/nextLevelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/zen_button_primary"
                    android:fontFamily="@font/ubuntu_medium"
                    android:minHeight="@dimen/zen_dialog_button_height"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/completion_next_puzzle"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
