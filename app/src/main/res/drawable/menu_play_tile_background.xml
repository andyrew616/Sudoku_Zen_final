<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/menu_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/menu_resume_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:endColor="@color/menu_surface_teal_wash"
                android:startColor="@color/menu_surface" />
            <stroke android:width="1dp" android:color="@color/menu_resume_border" />
        </shape>
    </item>
</selector>
