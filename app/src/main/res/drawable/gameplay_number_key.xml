<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gameplay_gold_soft" />
            <corners android:radius="@dimen/gameplay_number_key_radius" />
            <stroke
                android:width="@dimen/gameplay_number_key_stroke_width"
                android:color="@color/gameplay_number_key_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gameplay_number_key_surface" />
            <corners android:radius="@dimen/gameplay_number_key_radius" />
            <stroke
                android:width="@dimen/gameplay_number_key_stroke_width"
                android:color="@color/gameplay_number_key_border" />
        </shape>
    </item>
</selector>
