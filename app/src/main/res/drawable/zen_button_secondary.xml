<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/zen_primary_soft" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="@color/zen_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/zen_surface_pressed" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/zen_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zen_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/zen_surface_border" />
        </shape>
    </item>
</selector>
