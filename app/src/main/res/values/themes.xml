<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="Theme.AppCompat.Light.NoActionBar">

            <item name="colorPrimary">#673AB7</item> <!-- Deep Purple 500 -->
            <item name="colorPrimaryDark">#512DA8</item> <!-- Deep Purple 700 -->
            <item name="colorAccent">#29B6F6</item> <!-- Light Blue 400 -->

    </style>

    <style name="LaunchScreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/ic_splash</item>
    </style>
    <style name="MenuDifficultyTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/menu_difficulty_tile_height</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/menu_min_touch_target</item>
        <item name="android:minHeight">@dimen/menu_min_touch_target</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/menu_difficulty_tile_padding</item>
    </style>

    <style name="MenuDifficultyTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gameplay_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="MenuDifficultySubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/menu_difficulty_subtitle_gap</item>
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/gameplay_ink_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
