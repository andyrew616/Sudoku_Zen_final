<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.ZenSudoku.Menu.Tagline" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:textColor">@color/menu_ink_muted_strong</item>
        <item name="android:textSize">@dimen/menu_tagline_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.Section" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/menu_ink_muted_strong</item>
        <item name="android:textSize">@dimen/menu_section_label_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.ScreenTitle" parent="TextAppearance.AppCompat.Headline">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:textColor">@color/gameplay_ink</item>
        <item name="android:textSize">@dimen/menu_screen_title_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:textColor">@color/gameplay_ink_muted</item>
        <item name="android:textSize">@dimen/menu_body_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:textColor">@color/gameplay_ink</item>
        <item name="android:textSize">@dimen/menu_tile_title_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.UtilityTitle" parent="TextAppearance.ZenSudoku.Menu.Title">
        <item name="android:textSize">@dimen/menu_utility_title_size</item>
    </style>

    <style name="TextAppearance.ZenSudoku.Menu.Subtitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/ubuntu_regular</item>
        <item name="android:textColor">@color/gameplay_ink_muted</item>
        <item name="android:textSize">@dimen/menu_tile_subtitle_size</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
